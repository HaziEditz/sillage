# Clerk Dashboard API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Aiven PostgreSQL service URI (keep server-side; include sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Used to sign PayPal checkout cancellation tokens
SESSION_SECRET=replace_with_a_random_secret

# Optional: comma-separated email addresses allowed into the admin area
ADMIN_EMAILS=

# PayPal defaults to sandbox; live checkout stays disabled until explicitly enabled.
PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_CHECKOUT_ENABLED=false
STORE_POLICIES_FINAL=false

# Public HTTPS store URL required for live PayPal return/cancel URLs.
PUBLIC_APP_URL=

# Shipping fee in NZD cents. Sandbox defaults to 0; set this explicitly for live checkout.
SHIPPING_FEE_MINOR=

# Order emails. Gmail: host smtp.gmail.com, port 587, user the store Gmail, pass a Google app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
